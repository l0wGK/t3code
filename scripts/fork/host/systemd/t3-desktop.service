[Unit]
Description=Virtual GUI desktop (TigerVNC Xvnc :1 + noVNC) for agents and the T3 Desktop panel
After=default.target

[Service]
Type=simple
ExecStart=%h/desktop-service.sh
KillMode=control-group
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
