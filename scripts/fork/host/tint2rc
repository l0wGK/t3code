# Slim dark taskbar for the agent desktop (shown in the T3 Desktop panel).
# Background 1: panel
rounded = 0
border_width = 1
border_sides = T
background_color = #14151b 94
border_color = #ffffff 8
# Background 2: active task
rounded = 6
border_width = 0
background_color = #ffffff 16
border_color = #ffffff 0
background_color_hover = #ffffff 20
# Background 3: other tasks and launcher items
rounded = 6
border_width = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 10
background_color_pressed = #ffffff 16

panel_items = LTC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
autohide = 0
strut_policy = follow_size
wm_menu = 1
font_shadow = 0
mouse_effects = 1

launcher_padding = 2 0 4
launcher_background_id = 0
launcher_icon_background_id = 3
launcher_icon_size = 22
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/firefox.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 0 6
taskbar_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0

task_text = 1
task_icon = 1
task_centered = 0
task_tooltip = 1
task_maximum_size = 240 28
task_padding = 8 3 8
task_font = Sans 9
task_font_color = #c4c6cf 100
task_active_font_color = #ffffff 100
task_iconified_font_color = #7d7f89 100
task_background_id = 3
task_active_background_id = 2
task_iconified_background_id = 3
mouse_left = toggle_iconify
mouse_middle = close
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

time1_format = %H:%M
time2_format = %a %d %b
time1_font = Sans Bold 9
time2_font = Sans 7
clock_font_color = #e4e5ea 100
clock_padding = 8 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y
